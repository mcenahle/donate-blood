    src="https://playground.designsystem.umd.edu/assets/umd-smiling-graduates-Do_OWYp1.webp"
    alt="Smiling University of Maryland graduates in their regalia"
  />

  <p slot="eyebrow">example eyebrow</p>

  <p slot="headline">Lorem Ipsum Dolor Si</p>
  <div slot="text">
    <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
      tempor incididunt ut labore et dolore magna aliqua.
    </p>
  </div>

  <div slot="actions">
    <umd-element-call-to-action
