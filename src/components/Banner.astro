<style is:global>
  .alert {
    padding: 6px;
    margin-top: 0px;
    margin-bottom: 6px;
    margin-left: 6px;
    margin-right: 6px;
  }
</style>

<script>
  $(function () {
    $("[data-toggle='tooltip']").tooltip();
